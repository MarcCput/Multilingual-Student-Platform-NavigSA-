# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard -> Project Settings -> API
#
# Only the *anon* (public) key belongs here. It is safe in the browser because
# Row Level Security restricts what it can reach. Never put the service_role
# key in this file — it bypasses RLS entirely.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
